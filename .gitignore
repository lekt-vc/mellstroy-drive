# Git ignore for MELLDRIVE project

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc

# Environment variables & secrets
.env
.env.local
.env.*.local
*.config.local.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# IDE & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Temporary and build files
dist/
build/
tmp/
temp/
coverage/

# Database dumps (keep structure, ignore local dumps)
*.sqlite3
*.db
local_dump.sql
